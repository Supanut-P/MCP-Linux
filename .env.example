# Baitonghub-Linux-mcp headless configuration template
# Copy only the settings you need into a protected service environment file.
# Never commit real keys, tokens, tunnel IDs, or private paths.

# Required trust boundary
BAITONGHUB_LINUX_MCP_WORKSPACE=/srv/mcp-workspace
BAITONGHUB_LINUX_MCP_ALLOWED_ROOTS=/srv/mcp-workspace
BAITONGHUB_LINUX_MCP_STRICT_ROOTS=1

# Supply a fresh 32-byte base64 value through a protected environment or
# systemd credential. This placeholder is intentionally not usable.
BAITONGHUB_LINUX_MCP_CHECKPOINT_KEY_BASE64=

# Local Streamable HTTP MCP. Loopback is the default and recommended bind.
BAITONGHUB_LINUX_MCP_HTTP_HOST=127.0.0.1
BAITONGHUB_LINUX_MCP_HTTP_PORT=18765

# Required when binding a non-loopback address.
BAITONGHUB_LINUX_MCP_HTTP_TOKEN=
BAITONGHUB_LINUX_MCP_HTTP_ALLOWED_HOSTS=
BAITONGHUB_LINUX_MCP_HTTP_ALLOWED_ORIGINS=

# Optional path to the official OpenAI Secure MCP Tunnel client.
BAITONGHUB_LINUX_MCP_TUNNEL_CLIENT_PATH=/usr/local/bin/tunnel-client

# debug | info | warn | error
BAITONGHUB_LINUX_MCP_LOG_LEVEL=info

NODE_ENV=production

[Unit]
Description=Baitonghub-Linux-mcp OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/%i/.config/tunnel-client/baitonghub-linux-mcp.yaml

[Service]
Type=simple
User=%i
Environment=HOME=/home/%i
Environment=XDG_CONFIG_HOME=/home/%i/.config
Environment=XDG_DATA_HOME=/home/%i/.local/share
Environment=XDG_STATE_HOME=/home/%i/.local/state
EnvironmentFile=-/home/%i/.config/baitonghub-linux-mcp/tunnel.env
LoadCredential=control_plane_api_key:/etc/baitonghub-linux-mcp/%i/control-plane-api-key
LoadCredential=checkpoint_key_base64:/etc/baitonghub-linux-mcp/%i/checkpoint-key-base64
ExecStart=/opt/baitonghub-linux-mcp/start-baitonghub-linux-mcp-tunnel.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
